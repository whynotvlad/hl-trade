# ── Telegram bot ─────────────────────────────────────────────────────────────
# Generate DB_ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_TOKEN=your_bot_token_here
ALLOWED_TG_IDS=123456789,987654321
DB_ENCRYPTION_KEY=

# ── Option A: direct wallet (simplest, fine for testnet) ─────────────────────
# Put the private key of the wallet that holds your USDC deposits.
PRIVATE_KEY=0x_your_private_key_here
NETWORK=testnet   # or mainnet

# ── Option B: agent wallet (recommended for mainnet) ─────────────────────────
# 1. Generate a fresh wallet (see README for the one-liner).
# 2. Approve it as an agent on https://app.hyperliquid.xyz  (Settings → API).
# 3. Use the agent's private key below and set ACCOUNT_ADDRESS to your master wallet.
#
# PRIVATE_KEY=0x_agent_wallet_private_key
# ACCOUNT_ADDRESS=0x_your_main_account_address
# NETWORK=mainnet
